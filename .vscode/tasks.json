{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "West Build (Preset)",
      "type": "shell",
      "command": "west build -s . -d build/${input:presetSelect} -p auto -- --preset ${input:presetSelect} && cp build/${input:presetSelect}/compile_commands.json build/compile_commands.json",
      "options": {
        "cwd": "${workspaceFolder}/firmware"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "ZCBOR: Regenerate USB Schema",
      "type": "shell",
      "command": "zcbor",
      "args": [
        "code",
        "--decode",
        "--encode",
        "--short-names",
        "-c",
        "usb_msg.cddl",
        "-t",
        "Telemetry",
        "Command",
        "--output-c",
        "generated/usb_msg.c",
        "--output-h",
        "generated/usb_msg.h",
        "--output-h-types",
        "generated/usb_msg_types.h"
      ],
      "options": {
        "cwd": "${workspaceFolder}/firmware/src/modules/usb_mgr"
      },
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": [],
      "group": "none"
    },
    {
      "label": "West RAM Report",
      "type": "shell",
      "command": "west build -t ram_report -d build/${input:presetSelect}",
      "options": {
        "cwd": "${workspaceFolder}/firmware"
      },
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "West ROM Report",
      "type": "shell",
      "command": "west build -t rom_report -d build/${input:presetSelect}",
      "options": {
        "cwd": "${workspaceFolder}/firmware"
      },
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "Static Analysis: Logic & Standards - CodeChecker",
      "type": "shell",
      "command": "west build -p always -d build/${input:presetSelect}-codechecker -- --preset ${input:presetSelect} -DZEPHYR_SCA_VARIANT=codechecker \"-DCODECHECKER_ANALYZE_OPTS=--analyzers;clangsa;clang-tidy;cppcheck;gcc;--skip;${workspaceFolder}/firmware/codechecker.skip;--drop-reports-from-skipped-files\"",
      "options": {
        "cwd": "${workspaceFolder}/firmware"
      },
      "group": "none",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Static Analysis: Devicetree - DT Doctor",
      "type": "shell",
      "command": "west build -p always -d build/${input:presetSelect}-dtdoctor -- --preset ${input:presetSelect} -DZEPHYR_SCA_VARIANT=dtdoctor",
      "options": {
        "cwd": "${workspaceFolder}/firmware"
      },
      "group": "none",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Security: Harden Config Check",
      "type": "shell",
      "command": "west build -t hardenconfig -d build/${input:presetSelect}",
      "options": {
        "cwd": "${workspaceFolder}/firmware"
      },
      "group": "none",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": false
      }
    }
  ],
  "inputs": [
    {
      "id": "presetSelect",
      "type": "pickString",
      "description": "Select the target board and build type",
      "options": [
        "nucleo_h533re-debug",
        "nucleo_h533re-prod",
        "nucleo_l476rg-debug",
        "nucleo_l476rg-prod",
        "nucleo_f446ze-debug",
        "nucleo_f446ze-prod",
        "stm32f4_disco-debug",
        "stm32f4_disco-prod",
        "native_sim-debug",
        "native_sim-prod"
      ],
      "default": "nucleo_h533re-debug"
    }
  ]
}